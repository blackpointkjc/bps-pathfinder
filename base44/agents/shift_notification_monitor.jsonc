      ]
    },
    {
      "entity_name": "Notification",
      "allowed_operations": [
        "create",
        "read"
      ]
    },
    {
      "entity_name": "User",
      "allowed_operations": [
        "read"
      ]
    }
  ],
  "name": "shift_notification_monitor"
}