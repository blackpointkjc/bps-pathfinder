{
  "name": "generateScheduledPayroll",
  "entrypoint": "entry.ts",
  "automations": [
    {
      "name": "Generate payroll after configured period end",
      "description": "Checks hourly at 8:00 AM Eastern and automatically processes the oldest ended payroll period that is still missing payroll records, so a missed run is caught up automatically on the next check.",
      "type": "scheduled",
      "schedule_mode": "recurring",
      "schedule_type": "cron",
      "cron_expression": "0 * * * *",
      "is_active": true,
      "function_args": {}
    }
  ]
}
