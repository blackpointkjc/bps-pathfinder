{
  "name": "generateScheduledPayroll",
  "entrypoint": "entry.ts",
  "automations": [
    {
      "name": "Generate payroll after configured period end",
      "description": "Checks hourly and processes the oldest ended payroll period that is missing any eligible officer payroll record. The configured PayrollPeriod dates are authoritative and duplicate officer-period records are skipped.",
      "type": "scheduled",
      "schedule_mode": "recurring",
      "schedule_type": "cron",
      "cron_expression": "0 * * * *",
      "is_active": true,
      "function_args": {}
    }
  ]
}
