{
  "name": "generateScheduledPayroll",
  "entrypoint": "entry.ts",
  "automations": [
    {
      "name": "Generate payroll after configured period end",
      "description": "Checks hourly and automatically finalizes duplicate-safe gross payroll reports at 8:00 AM Eastern the day after a PayrollPeriod end date.",
      "type": "scheduled",
      "schedule_mode": "recurring",
      "schedule_type": "cron",
      "cron_expression": "0 * * * *",
      "is_active": true,
      "function_args": {}
    }
  ]
}
