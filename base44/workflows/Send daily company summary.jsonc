{
  "name": "Send daily company summary",
  "description": "Daily individual staff summaries at 8 AM Eastern via application-authorized management email.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "senddailycompanysummary",
      "version": "1.0.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_job": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendDailyCompanySummary",
            "args": {
              "scheduled": true
            }
          },
          "then": "end"
        }
      }
    ]
  }
}