{
  "name": "Ingest gractivecalls.com",
  "description": "Five-minute server runs perform ten bounded GRAC refreshes with short waits. No personnel login is required.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
