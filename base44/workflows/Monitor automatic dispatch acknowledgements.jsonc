{
  "name": "Monitor automatic dispatch acknowledgements",
  "description": "Server fallback every five minutes (platform minimum); existing foreground monitor retains its two-minute checks.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 5,
      "interval_unit": "minutes",
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "monitorautodispatchassignments",
      "version": "1.0.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_job": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "monitorAutoDispatchAssignments",
            "args": {
              "scheduled": true
            }
          },
          "then": "end"
        }
      }
    ]
  }
}