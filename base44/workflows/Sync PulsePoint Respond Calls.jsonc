{
  "name": "Sync PulsePoint Respond Calls",
  "description": "Imports active Richmond and Chesterfield PulsePoint Respond incidents into BPS CAD and creates CAD audio events for new incidents.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 1,
      "interval_unit": "minutes",
      "interval_anchor": "2026-09-26T00:00:00.000000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_pulsepoint_respond_calls",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "ingestPulsePoint",
            "args": {
              "scheduled": true,
              "include_audio": true,
              "area_keys": [
                "richmond_va",
                "chesterfield_va"
              ]
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-created-by": "codex"
}