{
  "name": "Archive Calls \u2014 Verified Server Maintenance",
  "description": "Every 15 minutes, archive eligible external calls and cleared internal calls; preserve active assignments and historical records.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 15,
      "interval_unit": "minutes",
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "archive_calls_maintenance_v2",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "archiveOldCalls",
            "args": {
              "scheduled": true
            }
          },
          "then": "end"
        }
      }
    ]
  }
}