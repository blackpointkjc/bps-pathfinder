{
  "name": "UnitSchedule",
  "type": "object",
  "properties": {
    "unit_id": {
      "type": "string",
      "description": "User/Unit ID"
    },
    "unit_name": {
      "type": "string",
      "description": "Unit identifier"
    },
    "shift_start": {
      "type": "string",
      "format": "date-time",
      "description": "Shift start time"
    },
    "shift_end": {
      "type": "string",
      "format": "date-time",
      "description": "Shift end time"
    },
    "shift_type": {
      "type": "string",
      "enum": [
        "day",
        "swing",
        "night",
        "overtime"
      ],
      "description": "Type of shift"
    },
    "notes": {
      "type": "string",
      "description": "Shift notes"
    }
  },
  "required": [
    "unit_id",
    "unit_name",
    "shift_start",
    "shift_end"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "portal_approved": true
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.unit_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.unit_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    }
  }
}
