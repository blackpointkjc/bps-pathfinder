{
  "name": "Message",
  "type": "object",
  "properties": {
    "sender_id": {
      "type": "string",
      "description": "ID of sender"
    },
    "sender_name": {
      "type": "string",
      "description": "Name of sender"
    },
    "recipient_id": {
      "type": "string",
      "description": "ID of recipient (user or 'dispatch' for all dispatchers)"
    },
    "recipient_name": {
      "type": "string",
      "description": "Name of recipient"
    },
    "message": {
      "type": "string",
      "description": "Message content"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "Whether message has been read"
    },
    "call_id": {
      "type": "string",
      "description": "Related call ID if applicable"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "dispatch_message",
        "company_broadcast"
      ],
      "default": "dispatch_message",
      "description": "Operational direct message or company-wide broadcast"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description or context for this message thread"
    }
  },
  "required": [
    "sender_id",
    "sender_name",
    "recipient_id",
    "message"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "dispatch"
        },
        {
          "data.recipient_id": "company"
        },
        {
          "data.sender_id": "dispatch"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}