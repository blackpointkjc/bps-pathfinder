{
  "name": "MicrosoftTeamsIdentity",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "pathfinder_email": {
      "type": "string"
    },
    "microsoft_email": {
      "type": "string"
    },
    "microsoft_user_id": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "microsoft_email"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}