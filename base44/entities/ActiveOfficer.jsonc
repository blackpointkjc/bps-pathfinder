{
  "name": "ActiveOfficer",
  "type": "object",
  "properties": {
    "officer_email": {
      "type": "string",
      "description": "Email of the active officer"
    },
    "officer_name": {
      "type": "string",
      "description": "Name of the officer"
    },
    "current_location": {
      "type": "string",
      "description": "Current assigned location"
    },
    "clock_in_time": {
      "type": "string",
      "format": "date-time",
      "description": "When they clocked in"
    },
    "last_update": {
      "type": "string",
      "format": "date-time",
      "description": "Last activity update"
    },
    "latitude": {
      "type": "number",
      "description": "Current GPS latitude"
    },
    "longitude": {
      "type": "number",
      "description": "Current GPS longitude"
    },
    "heading": {
      "type": "number",
      "description": "Current direction of travel in degrees"
    },
    "speed": {
      "type": "number",
      "description": "Current speed in miles per hour"
    },
    "accuracy": {
      "type": "number",
      "description": "GPS fix accuracy in meters"
    },
    "unit_number": {
      "type": "string",
      "description": "Officer or vehicle unit number"
    },
    "status": {
      "type": "string",
      "description": "Current duty status"
    },
    "user_role": {
      "type": "string",
      "description": "Current application role"
    },
    "session_active": {
      "type": "boolean",
      "description": "Whether this signed-in tracking session is active"
    },
    "show_lights": {
      "type": "boolean",
      "description": "Whether emergency lights are active"
    },
    "current_call_info": {
      "type": "string",
      "description": "Current assigned call summary"
    }
  },
  "required": [
    "officer_email",
    "officer_name",
    "current_location",
    "clock_in_time"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}