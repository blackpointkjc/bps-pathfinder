{
  "name": "Client",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "Client company name"
    },
    "industry": {
      "type": "string",
      "description": "Industry type"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended",
        "prospect"
      ],
      "default": "active"
    },
    "primary_contact_name": {
      "type": "string"
    },
    "primary_contact_email": {
      "type": "string"
    },
    "primary_contact_phone": {
      "type": "string"
    },
    "billing_address": {
      "type": "string"
    },
    "assigned_manager": {
      "type": "string",
      "description": "User ID of account manager"
    },
    "assigned_manager_name": {
      "type": "string"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "low"
    },
    "notes": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_lead_id": {
      "type": "string",
      "description": "Original lead ID"
    },
    "last_incident_date": {
      "type": "string",
      "format": "date-time"
    },
    "health_score": {
      "type": "number",
      "description": "0-100 account health score"
    }
  },
  "required": [
    "company_name"
  ]
}