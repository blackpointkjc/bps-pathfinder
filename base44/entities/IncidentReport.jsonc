{
  "name": "IncidentReport",
  "type": "object",
  "properties": {
    "report_number": {
      "type": "string",
      "description": "System-generated report number"
    },
    "call_number": {
      "type": "string",
      "description": "Call number for tracking"
    },
    "police_report_number": {
      "type": "string",
      "description": "Police department report number if police were called"
    },
    "incident_date": {
      "type": "string",
      "format": "date",
      "description": "Date of incident"
    },
    "incident_time": {
      "type": "string",
      "description": "Time of incident (HH:MM format)"
    },
    "discovered_time": {
      "type": "string",
      "description": "Time incident was discovered (if different)"
    },
    "location": {
      "type": "string",
      "description": "Location where incident occurred"
    },
    "specific_location": {
      "type": "string",
      "description": "Specific location details (building, floor, unit)"
    },
    "incident_type": {
      "type": "string",
      "enum": [
        "theft",
        "vandalism",
        "assault",
        "trespassing",
        "medical",
        "fire",
        "shooting",
        "vehicle_pursuit",
        "property_damage",
        "disturbance",
        "suspicious_activity",
        "other"
      ],
      "description": "Type of incident"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the incident"
    },
    "suspect_description": {
      "type": "string",
      "description": "Physical description of suspect(s)"
    },
    "suspect_vehicle": {
      "type": "string",
      "description": "Suspect vehicle information"
    },
    "persons_involved": {
      "type": "string",
      "description": "Names and details of persons involved"
    },
    "victims": {
      "type": "string",
      "description": "Victim information and contact"
    },
    "witnesses": {
      "type": "string",
      "description": "Witness information"
    },
    "injuries_reported": {
      "type": "boolean",
      "default": false,
      "description": "Whether injuries were reported"
    },
    "injury_details": {
      "type": "string",
      "description": "Details of injuries if any"
    },
    "property_damage": {
      "type": "boolean",
      "default": false,
      "description": "Whether property damage occurred"
    },
    "damage_details": {
      "type": "string",
      "description": "Details of property damage"
    },
    "estimated_value": {
      "type": "string",
      "description": "Estimated value of loss or damage"
    },
    "action_taken": {
      "type": "string",
      "description": "Actions taken by officer"
    },
    "police_notified": {
      "type": "boolean",
      "default": false,
      "description": "Whether police were called"
    },
    "ems_notified": {
      "type": "boolean",
      "default": false,
      "description": "Whether EMS was called"
    },
    "fire_notified": {
      "type": "boolean",
      "default": false,
      "description": "Whether fire department was called"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Photos of the incident scene"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "rejected",
        "approved"
      ],
      "default": "submitted"
    },
    "admin_notes": {
      "type": "string",
      "description": "Admin feedback for revisions"
    },
    "was_rejected": {
      "type": "boolean",
      "default": false,
      "description": "Whether this report was previously rejected"
    },
    "officer_ip_address": {
      "type": "string",
      "description": "IP address of officer when submitting report"
    },
    "reporting_officer_id": {
      "type": "string",
      "description": "User ID of the officer who authored/submitted the report"
    },
    "reporting_officer_email": {
      "type": "string",
      "description": "Cached reporting officer email for durable display and matching"
    },
    "reporting_officer_name": {
      "type": "string",
      "description": "Cached reporting officer display name"
    },
    "reporting_officer_signature": {
      "type": "string",
      "description": "Cached reporting officer rank/last-name/unit signature"
    },
    "linked_call_id": {
      "type": "string",
      "description": "Linked Pathfinder DispatchCall record ID"
    },
    "linked_call_number": {
      "type": "string",
      "description": "Linked CAD call number"
    },
    "linked_bolo_id": {
      "type": "string",
      "description": "Linked BOLOAlert record ID"
    },
    "linked_bolo_number": {
      "type": "string",
      "description": "Linked BOLO number"
    },
    "suspect_id_scanned": {
      "type": "boolean",
      "default": false,
      "description": "Whether suspect ID was scanned"
    },
    "suspect_scan_data": {
      "type": "string",
      "description": "Suspect scan metadata as JSON"
    },
    "witness_id_scanned": {
      "type": "boolean",
      "default": false,
      "description": "Whether witness ID was scanned"
    },
    "witness_scan_data": {
      "type": "string",
      "description": "Witness scan metadata as JSON"
    },
    "victim_id_scanned": {
      "type": "boolean",
      "default": false,
      "description": "Whether victim ID was scanned"
    },
    "victim_scan_data": {
      "type": "string",
      "description": "Victim scan metadata as JSON"
    },
    "primary_officer_id": {
      "type": "string",
      "description": "Primary officer user ID from the linked call"
    },
    "primary_officer_name": {
      "type": "string",
      "description": "Primary officer display name from the linked call"
    },
    "backup_officer_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Backup officer IDs from the linked call"
    },
    "attached_officer_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional officer user IDs attached to this report"
    },
    "attached_officer_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional officer emails attached to this report"
    },
    "attached_officer_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Display names of additional officers attached to this report"
    },
    "report_type": {
      "type": "string",
      "enum": [
        "original",
        "supplement"
      ],
      "default": "original",
      "description": "Whether this is the original incident report or a supplemental report"
    },
    "parent_report_id": {
      "type": "string",
      "description": "Original IncidentReport ID when this record is a supplement"
    },
    "parent_report_number": {
      "type": "string",
      "description": "Original report number when this record is a supplement"
    },
    "supplement_number": {
      "type": "number",
      "description": "Sequential supplement number for the original incident report"
    }
  },
  "required": [
    "incident_date",
    "incident_time",
    "location",
    "incident_type",
    "description"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}