{
  "name": "CallHistory",
  "type": "object",
  "properties": {
    "original_call_id": {
      "type": "string",
      "description": "Original DispatchCall record ID retained after archiving"
    },
    "call_id": {
      "type": "string",
      "description": "Visible/upstream CAD or BPS call identifier"
    },
    "bps_reference": {
      "type": "string",
      "description": "Internal Black Point Security call reference preserved for report linking search"
    },
    "agency_cad_number": {
      "type": "string",
      "description": "Official agency CAD number preserved for report linking search"
    },
    "external_call_id": {
      "type": "string",
      "description": "Optional upstream external call identifier"
    },
    "time_received": {
      "type": "string",
      "description": "Time the call was received"
    },
    "incident": {
      "type": "string",
      "description": "Type of incident"
    },
    "location": {
      "type": "string",
      "description": "Call location"
    },
    "agency": {
      "type": "string",
      "description": "Responding agency"
    },
    "status": {
      "type": "string",
      "description": "Call status"
    },
    "latitude": {
      "type": "number",
      "description": "Latitude coordinate"
    },
    "longitude": {
      "type": "number",
      "description": "Longitude coordinate"
    },
    "ai_summary": {
      "type": "string",
      "description": "AI-generated summary"
    },
    "archived_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the call was archived"
    },
    "description": {
      "type": "string",
      "description": "Retained original CAD description"
    },
    "disposition": {
      "type": "string",
      "description": "Retained original CAD disposition"
    },
    "cross_street": {
      "type": "string",
      "description": "Retained original CAD cross street"
    },
    "zone": {
      "type": "string",
      "description": "Retained original CAD zone"
    },
    "priority": {
      "type": "string",
      "description": "Retained original CAD priority"
    },
    "caller_name": {
      "type": "string",
      "description": "Retained original CAD caller name"
    },
    "caller_phone": {
      "type": "string",
      "description": "Retained original CAD caller phone"
    },
    "hazards": {
      "type": "string",
      "description": "Retained original CAD hazards"
    },
    "source": {
      "type": "string",
      "description": "Retained original CAD source"
    },
    "time_dispatched": {
      "type": "string",
      "description": "Retained original CAD time dispatched"
    },
    "time_enroute": {
      "type": "string",
      "description": "Retained original CAD time enroute"
    },
    "time_on_scene": {
      "type": "string",
      "description": "Retained original CAD time on scene"
    },
    "time_cleared": {
      "type": "string",
      "description": "Retained original CAD time cleared"
    },
    "time_closed": {
      "type": "string",
      "description": "Retained original CAD time closed"
    },
    "assigned_units": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Retained assigned unit identifiers"
    }
  },
  "required": [
    "time_received",
    "incident",
    "location",
    "agency"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "portal_approved": true
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
