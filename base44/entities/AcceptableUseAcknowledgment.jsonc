{
  "name": "AcceptableUseAcknowledgment",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "policy_title": {
      "type": "string"
    },
    "signed_name": {
      "type": "string"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "approved"
      ],
      "default": "approved"
    },
    "user_agent": {
      "type": "string"
    },
    "source": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "user_email",
    "policy_version",
    "accepted_at",
    "signed_name",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}