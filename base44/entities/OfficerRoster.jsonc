{
  "name": "OfficerRoster",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "Officer's first name"
    },
    "last_name": {
      "type": "string",
      "description": "Officer's last name"
    },
    "rank": {
      "type": "string",
      "description": "Officer's rank"
    },
    "unit_number": {
      "type": "string",
      "description": "Unit number"
    },
    "badge_number": {
      "type": "string",
      "description": "Badge number"
    },
    "mobile_phone": {
      "type": "string",
      "description": "Mobile phone number"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "division": {
      "type": "string",
      "description": "Region assignment"
    },
    "subdivision": {
      "type": "string",
      "description": "Operating division"
    },
    "substation": {
      "type": "string",
      "description": "Field officer substation"
    },
    "hire_date": {
      "type": "string",
      "format": "date",
      "description": "Hire date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active",
      "description": "Employment status"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "first_name",
    "last_name"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "portal_approved": true
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
