{
  "name": "LocationHistory",
  "type": "object",
  "properties": {
    "time_entry_id": {
      "type": "string",
      "description": "ID of the time entry this location belongs to"
    },
    "officer_email": {
      "type": "string",
      "description": "Email of the officer"
    },
    "officer_name": {
      "type": "string",
      "description": "Name of the officer"
    },
    "location": {
      "type": "string",
      "description": "Location where officer was tracked"
    },
    "latitude": {
      "type": "number",
      "description": "GPS latitude"
    },
    "longitude": {
      "type": "number",
      "description": "GPS longitude"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When this location was recorded"
    },
    "accuracy": {
      "type": "number",
      "description": "GPS accuracy in meters"
    },
    "speed": {
      "type": "number",
      "description": "Officer speed in miles per hour at this recorded GPS point"
    },
    "heading": {
      "type": "number",
      "description": "Direction of travel in degrees at this recorded GPS point"
    },
    "gps_source": {
      "type": "string",
      "description": "GPS source for this point, such as browser_geolocation or external_serial"
    }
  },
  "required": [
    "officer_email",
    "officer_name",
    "latitude",
    "longitude",
    "timestamp"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}