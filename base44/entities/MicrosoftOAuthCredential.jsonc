{
  "name": "MicrosoftOAuthCredential",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "pathfinder_email": {
      "type": "string"
    },
    "microsoft_email": {
      "type": "string"
    },
    "microsoft_user_id": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "refresh_token": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "__service_only__"
          }
        }
      }
    },
    "scope": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "connected_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_refreshed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_error": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "refresh_token"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
