{
  "name": "InboxThreadPreference",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "thread_key": {
      "type": "string"
    },
    "hidden": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_email",
    "thread_key"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "email": "{{user.email}}"
      }
    },
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}