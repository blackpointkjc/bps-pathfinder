{
  "name": "InboxThreadPreference",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "thread_key": {
      "type": "string"
    },
    "hidden": {
      "type": "boolean",
      "default": true
    },
    "hidden_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the user archived the conversation"
    }
  },
  "required": [
    "user_email",
    "thread_key"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "data.user_email": "{{user.email}}"
    }
  }
}