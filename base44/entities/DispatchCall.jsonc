{
  "name": "DispatchCall",
  "type": "object",
  "properties": {
    "call_id": {
      "type": "string",
      "description": "Primary display identifier: official agency CAD number when published, otherwise the internal BPS reference"
    },
    "agency_cad_number": {
      "type": "string",
      "description": "Official CAD number published by the responding government agency or its public data feed"
    },
    "bps_reference": {
      "type": "string",
      "description": "Unique internal Black Point Security call reference"
    },
    "cad_number_source": {
      "type": "string",
      "enum": [
        "official_government_feed",
        "upstream_public_feed",
        "bps_internal"
      ],
      "description": "Provenance of the primary call identifier"
    },
    "official_cad_verified": {
      "type": "boolean",
      "default": false,
      "description": "True only when an explicit agency CAD field was supplied by the upstream public feed"
    },
    "external_call_id": {
      "type": "string",
      "description": "Stable upstream GRAC call identifier used for idempotent synchronization"
    },
    "incident": {
      "type": "string",
      "description": "Type of incident"
    },
    "location": {
      "type": "string",
      "description": "Call location"
    },
    "cross_street": {
      "type": "string",
      "description": "Nearest cross street"
    },
    "landmark": {
      "type": "string",
      "description": "Nearby landmark"
    },
    "latitude": {
      "type": "number",
      "description": "Geocoded latitude"
    },
    "longitude": {
      "type": "number",
      "description": "Geocoded longitude"
    },
    "geo_confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "unmappable"
      ],
      "description": "Geocoding confidence level"
    },
    "geo_method": {
      "type": "string",
      "enum": [
        "exact",
        "block",
        "intersection",
        "street",
        "grac",
        "none"
      ],
      "description": "Method used to geocode the location"
    },
    "geo_approximate": {
      "type": "boolean",
      "default": false,
      "description": "True if coordinates are approximate, not exact"
    },
    "description": {
      "type": "string",
      "description": "Detailed description"
    },
    "ai_summary": {
      "type": "string",
      "description": "AI-generated summary of call"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "agency": {
      "type": "string",
      "description": "Responding agency"
    },
    "zone": {
      "type": "string",
      "description": "Dispatch zone or beat"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "Dispatched",
        "Enroute",
        "On Scene",
        "Cleared",
        "Cancelled"
      ],
      "default": "New"
    },
    "assigned_units": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of assigned unit IDs"
    },
    "caller_name": {
      "type": "string",
      "description": "Name of caller"
    },
    "caller_phone": {
      "type": "string",
      "description": "Caller phone number"
    },
    "hazards": {
      "type": "string",
      "description": "Known hazards or warnings"
    },
    "time_received": {
      "type": "string",
      "format": "date-time",
      "description": "When call was received"
    },
    "time_dispatched": {
      "type": "string",
      "format": "date-time",
      "description": "When call was dispatched"
    },
    "time_enroute": {
      "type": "string",
      "format": "date-time",
      "description": "When unit(s) went enroute"
    },
    "time_on_scene": {
      "type": "string",
      "format": "date-time",
      "description": "When unit(s) arrived on scene"
    },
    "time_cleared": {
      "type": "string",
      "format": "date-time",
      "description": "When call was cleared"
    },
    "time_closed": {
      "type": "string",
      "format": "date-time",
      "description": "When call was closed"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "File URLs for attachments"
    },
    "source": {
      "type": "string",
      "enum": [
        "richmond",
        "henrico",
        "chesterfield"
      ],
      "description": "Data source (richmond, henrico, or chesterfield)"
    }
  },
  "required": [
    "incident",
    "location"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}