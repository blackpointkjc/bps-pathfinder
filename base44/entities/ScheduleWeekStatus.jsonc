{
  "name": "ScheduleWeekStatus",
  "type": "object",
  "properties": {
    "week_start_date": {
      "type": "string",
      "format": "date",
      "description": "Start date of the week (Sunday)"
    },
    "week_end_date": {
      "type": "string",
      "format": "date",
      "description": "End date of the week (Saturday)"
    },
    "is_ready": {
      "type": "boolean",
      "default": false,
      "description": "Whether this week's schedule is ready to be viewed by officers and clients"
    },
    "marked_ready_by": {
      "type": "string",
      "description": "Email of admin who marked it ready"
    },
    "marked_ready_date": {
      "type": "string",
      "format": "date-time",
      "description": "When it was marked ready"
    },
    "unpublished_officer_emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "publication_key": {
      "type": "string"
    },
    "delivery_lock_token": {
      "type": "string"
    },
    "delivery_locked_until": {
      "type": "string",
      "format": "date-time"
    },
    "delivery_status": {
      "type": "string",
      "enum": [
        "pending",
        "complete"
      ]
    },
    "delivery_recipient_count": {
      "type": "number"
    },
    "delivery_sent_count": {
      "type": "number"
    },
    "delivery_updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "week_start_date",
    "week_end_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
