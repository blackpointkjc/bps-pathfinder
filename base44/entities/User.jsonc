{
  "name": "User",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "ssn": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "rank": {
      "type": "string"
    },
    "unit_number": {
      "type": "string"
    },
    "badge_number": {
      "type": "string"
    },
    "mobile_phone": {
      "type": "string"
    },
    "division": {
      "type": "string"
    },
    "subdivision": {
      "type": "string"
    },
    "hire_date": {
      "type": "string",
      "format": "date"
    },
    "termination_date": {
      "type": "string",
      "format": "date"
    },
    "hourly_rate": {
      "type": "number"
    },
    "overtime_rate_override": {
      "type": "number"
    },
    "holiday_rate_override": {
      "type": "number"
    },
    "work_state": {
      "type": "string"
    },
    "employment_status": {
      "type": "string",
      "enum": [
        "active",
        "terminated",
        "on_leave"
      ],
      "default": "active"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "direct_deposit",
        "check",
        "cash"
      ],
      "default": "direct_deposit"
    },
    "bank_account_last4": {
      "type": "string"
    },
    "bank_routing_number": {
      "type": "string"
    },
    "tax_filing_status": {
      "type": "string",
      "enum": [
        "single",
        "married_joint",
        "married_separate",
        "head_of_household"
      ]
    },
    "w4_step2_checkbox": {
      "type": "boolean",
      "default": false
    },
    "w4_step3_dependents_amount": {
      "type": "number",
      "default": 0
    },
    "w4_step4a_other_income": {
      "type": "number",
      "default": 0
    },
    "w4_step4b_deductions": {
      "type": "number",
      "default": 0
    },
    "w4_step4c_extra_withholding": {
      "type": "number",
      "default": 0
    },
    "exempt_from_federal_tax": {
      "type": "boolean",
      "default": false
    },
    "exempt_from_state_tax": {
      "type": "boolean",
      "default": false
    },
    "state_withholding_allowances": {
      "type": "number",
      "default": 0
    },
    "additional_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assigned_location": {
      "type": "string"
    },
    "assigned_locations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assigned_sites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dcjs_number": {
      "type": "string",
      "description": "DCJS License Number"
    },
    "dcjs_expiration": {
      "type": "string",
      "format": "date"
    },
    "firearm_expiration": {
      "type": "string",
      "format": "date"
    },
    "profile_photo_url": {
      "type": "string"
    },
    "hidden_portals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pto_balance_hours": {
      "type": "number",
      "default": 0
    },
    "pto_year_to_date_accrued": {
      "type": "number",
      "default": 0
    },
    "pto_year_to_date_used": {
      "type": "number",
      "default": 0
    },
    "sick_time_balance_hours": {
      "type": "number",
      "default": 0
    },
    "sick_time_year_to_date_used": {
      "type": "number",
      "default": 0
    },
    "sick_leave_converted": {
      "type": "boolean",
      "default": false
    },
    "emergency_contact_name": {
      "type": "string"
    },
    "emergency_contact_relationship": {
      "type": "string"
    },
    "emergency_contact_phone": {
      "type": "string"
    },
    "drivers_license_number": {
      "type": "string"
    },
    "drivers_license_state": {
      "type": "string"
    },
    "drivers_license_expiration": {
      "type": "string",
      "format": "date"
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Legacy additional certifications"
    },
    "officer_certifications": {
      "type": "array",
      "description": "Structured certification tracking - DCJS and company certifications",
      "items": {
        "type": "object",
        "properties": {
          "course_id": {
            "type": "string",
            "description": "e.g. 01E, 07R, CPR"
          },
          "training_name": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "description": "dcjs or company"
          },
          "status": {
            "type": "string",
            "description": "active, expired, pending"
          },
          "issue_date": {
            "type": "string",
            "format": "date"
          },
          "expiration_date": {
            "type": "string",
            "format": "date"
          },
          "renewal_period_months": {
            "type": "number"
          },
          "notes": {
            "type": "string"
          },
          "manually_verified": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "required": [
    "first_name",
    "last_name",
    "ssn",
    "date_of_birth",
    "address",
    "city",
    "state",
    "zip",
    "rank",
    "unit_number",
    "badge_number",
    "mobile_phone",
    "division",
    "subdivision",
    "hire_date",
    "termination_date",
    "hourly_rate",
    "overtime_rate_override",
    "holiday_rate_override",
    "work_state",
    "bank_account_last4",
    "bank_routing_number",
    "tax_filing_status",
    "additional_roles",
    "assigned_location",
    "assigned_locations",
    "assigned_sites",
    "dcjs_number",
    "dcjs_expiration",
    "firearm_expiration",
    "profile_photo_url",
    "hidden_portals",
    "emergency_contact_name",
    "emergency_contact_relationship",
    "emergency_contact_phone",
    "drivers_license_number",
    "drivers_license_state",
    "drivers_license_expiration",
    "certifications",
    "officer_certifications"
  ]
}