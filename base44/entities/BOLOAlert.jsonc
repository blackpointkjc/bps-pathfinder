{
  "name": "BOLOAlert",
  "type": "object",
  "properties": {
    "bolo_number": {
      "type": "string",
      "description": "Auto-generated BOLO number"
    },
    "alert_type": {
      "type": "string",
      "enum": [
        "wanted_person",
        "missing_person",
        "stolen_vehicle",
        "officer_safety",
        "special_instruction",
        "property_alert",
        "watch_notice"
      ],
      "description": "Type of BOLO alert"
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "cancelled",
        "expired",
        "located",
        "resolved"
      ],
      "default": "active"
    },
    "title": {
      "type": "string",
      "description": "Short headline"
    },
    "description": {
      "type": "string",
      "description": "Full narrative"
    },
    "subject_name": {
      "type": "string"
    },
    "subject_dob": {
      "type": "string"
    },
    "subject_race": {
      "type": "string"
    },
    "subject_sex": {
      "type": "string"
    },
    "subject_height": {
      "type": "string"
    },
    "subject_weight": {
      "type": "string"
    },
    "subject_description": {
      "type": "string"
    },
    "vehicle_make": {
      "type": "string"
    },
    "vehicle_model": {
      "type": "string"
    },
    "vehicle_year": {
      "type": "string"
    },
    "vehicle_color": {
      "type": "string"
    },
    "vehicle_plate": {
      "type": "string"
    },
    "last_known_location": {
      "type": "string"
    },
    "jurisdiction": {
      "type": "string"
    },
    "issued_by": {
      "type": "string"
    },
    "issued_by_id": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "contact_info": {
      "type": "string"
    },
    "case_number": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_by": {
      "type": "string"
    },
    "resolved_by_id": {
      "type": "string"
    },
    "resolution_notes": {
      "type": "string"
    },
    "linked_call_id": {
      "type": "string",
      "description": "Linked DispatchCall record ID"
    },
    "linked_call_number": {
      "type": "string",
      "description": "Linked CAD / BPS call reference"
    },
    "linked_incident_report_id": {
      "type": "string",
      "description": "Linked IncidentReport record ID"
    },
    "linked_incident_report_number": {
      "type": "string",
      "description": "Linked incident report number"
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Existing BOLO image attachments"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "mime_type": {
            "type": "string"
          },
          "size": {
            "type": "number"
          },
          "kind": {
            "type": "string",
            "enum": [
              "image",
              "document"
            ]
          },
          "uploaded_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Additional BOLO photographs, PDFs, and supported documents"
    },
    "parties": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Structured persons/parties associated with the BOLO"
    },
    "vehicles": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Structured vehicles associated with the BOLO"
    }
  },
  "required": [
    "alert_type",
    "title",
    "priority",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.issued_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.issued_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}