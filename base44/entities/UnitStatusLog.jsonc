{
  "name": "UnitStatusLog",
  "type": "object",
  "properties": {
    "unit_id": {
      "type": "string",
      "description": "User/Unit ID"
    },
    "unit_name": {
      "type": "string",
      "description": "Unit identifier"
    },
    "old_status": {
      "type": "string",
      "description": "Previous status"
    },
    "new_status": {
      "type": "string",
      "description": "New status"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes about status change"
    },
    "location_lat": {
      "type": "number",
      "description": "Latitude at time of change"
    },
    "location_lng": {
      "type": "number",
      "description": "Longitude at time of change"
    },
    "call_id": {
      "type": "string",
      "description": "Associated call ID if applicable"
    }
  },
  "required": [
    "unit_id",
    "new_status"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "portal_approved": true
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
