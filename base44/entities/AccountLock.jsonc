{
  "name": "AccountLock",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "locked": {
      "type": "boolean",
      "default": true
    },
    "reason": {
      "type": "string",
      "maxLength": 1000
    },
    "message": {
      "type": "string",
      "maxLength": 1000
    },
    "locked_by_email": {
      "type": "string"
    },
    "locked_by_name": {
      "type": "string"
    },
    "locked_at": {
      "type": "string",
      "format": "date-time"
    },
    "unlocked_by_email": {
      "type": "string"
    },
    "unlocked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "user_email",
    "locked",
    "locked_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}