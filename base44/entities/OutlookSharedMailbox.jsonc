{
  "name": "OutlookSharedMailbox",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Pathfinder user ID who linked this shared mailbox"
    },
    "pathfinder_email": {
      "type": "string",
      "description": "Pathfinder account email"
    },
    "mailbox_email": {
      "type": "string",
      "description": "Shared Microsoft 365 mailbox SMTP address"
    },
    "display_name": {
      "type": "string",
      "description": "Shared mailbox display name"
    },
    "microsoft_user_id": {
      "type": "string",
      "description": "Microsoft Graph object ID for the shared mailbox"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_used_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "mailbox_email"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    }
  }
}
