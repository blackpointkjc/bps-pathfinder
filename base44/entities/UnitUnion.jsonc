{
  "name": "UnitUnion",
  "type": "object",
  "properties": {
    "union_name": {
      "type": "string",
      "description": "Union identifier (e.g., union-01)"
    },
    "lead_unit_id": {
      "type": "string",
      "description": "Primary unit ID"
    },
    "member_unit_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of member unit IDs"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disbanded"
      ],
      "default": "active",
      "description": "Union status"
    },
    "formed_date": {
      "type": "string",
      "format": "date-time",
      "description": "When union was formed"
    },
    "disbanded_date": {
      "type": "string",
      "format": "date-time",
      "description": "When union was disbanded"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description of this unit group's purpose or assignment"
    }
  },
  "required": [
    "union_name",
    "lead_unit_id",
    "member_unit_ids"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "data.lead_unit_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.lead_unit_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}