{
  "name":"PortalShowcase", "type":"object",
  "properties":{
    "kind":{"type":"string","enum":["photo","officer","supervisor"]},
    "title":{"type":"string"},"caption":{"type":"string"},
    "image_url":{"type":"string"},"month":{"type":"string"},
    "active":{"type":"boolean","default":true},
    "sort_order":{"type":"number","default":0},
    "updated_by":{"type":"string"}
  },
  "required":["kind","title","active"],
  "rls":{"create":{"user_condition":{"role":"admin"}},"read":{"user_condition":{"role":"admin"}},"update":{"user_condition":{"role":"admin"}},"delete":{"user_condition":{"role":"admin"}}}
}
