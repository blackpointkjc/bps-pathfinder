{
  "name": "VehicleAssignment",
  "type": "object",
  "properties": {
    "assignment_date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "vehicle_id": {
      "type": "string",
      "description": "Vehicle entity record id"
    },
    "vehicle_label": {
      "type": "string",
      "description": "Fleet vehicle identifier"
    },
    "primary_officer_email": {
      "type": "string"
    },
    "primary_officer_name": {
      "type": "string"
    },
    "partner_officer_email": {
      "type": "string"
    },
    "partner_officer_name": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "active",
        "completed",
        "cancelled"
      ],
      "default": "scheduled"
    },
    "notes": {
      "type": "string"
    },
    "created_by_email": {
      "type": "string"
    },
    "source_schedule_id": {
      "type": "string"
    },
    "assignment_source": {
      "type": "string",
      "enum": [
        "manual",
        "officer_default"
      ]
    }
  },
  "required": [
    "assignment_date",
    "vehicle_id",
    "primary_officer_email"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.primary_officer_email": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "portal_approved": true
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.primary_officer_email": "{{user.email}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
