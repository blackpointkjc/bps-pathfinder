{
  "name": "PortalShowcase",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "video",
        "photo",
        "officer",
        "supervisor"
      ]
    },
    "title": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "month": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "updated_by": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "description": "Existing employee selected for monthly recognition"
    },
    "builtin": {
      "type": "boolean",
      "description": "Identifies the original fleet gallery item so other videos remain independent"
    },
    "archived": {
      "type": "boolean",
      "description": "Hidden from the gallery without permanently deleting the saved media record"
    }
  },
  "required": [
    "kind",
    "title",
    "active"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
