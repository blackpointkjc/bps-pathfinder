{
  "name": "RecurringCompanyBill",
  "type": "object",
  "properties": {
    "vendor": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "site_name": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "next_due_date": {
      "type": "string",
      "format": "date"
    },
    "day_of_month": {
      "type": "number"
    },
    "status_on_post": {
      "type": "string",
      "enum": [
        "unpaid",
        "paid"
      ],
      "default": "unpaid"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    },
    "last_posted_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "vendor",
    "description",
    "amount",
    "category",
    "start_date",
    "next_due_date",
    "day_of_month",
    "active",
    "status_on_post"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "id": "6a72bbee2842d6338cbae513"
          }
        }
      ]
    },
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "id": "6a72bbee2842d6338cbae513"
          }
        }
      ]
    },
    "update": {
