{
  "name": "OpenDoorReport",
  "type": "object",
  "properties": {
    "linked_call_id": {
      "type": "string",
      "description": "Linked DispatchCall record ID"
    },
    "linked_call_number": {
      "type": "string",
      "description": "Linked CAD call number"
    },
    "linked_call_type": {
      "type": "string",
      "description": "Linked CAD incident type"
    },
    "linked_call_location": {
      "type": "string",
      "description": "Linked CAD call location"
    },
    "report_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date and time of report"
    },
    "location": {
      "type": "string",
      "description": "Location of the open door"
    },
    "door_description": {
      "type": "string",
      "description": "Description of which door (e.g., Main entrance, Unit 204)"
    },
    "action_taken": {
      "type": "string",
      "description": "What action was taken (secured, notified resident, etc.)"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "photo_url": {
      "type": "string",
      "description": "Photo of the open door"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "secured",
        "referred"
      ],
      "default": "open",
      "description": "Status of the door"
    },
    "officer_ip_address": {
      "type": "string",
      "description": "IP address of officer when submitting report"
    }
  },
  "required": [
    "report_date",
    "location",
    "door_description"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}