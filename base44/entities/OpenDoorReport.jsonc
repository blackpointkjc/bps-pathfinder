{
  "name": "OpenDoorReport",
  "type": "object",
  "properties": {
    "report_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date and time of report"
    },
    "location": {
      "type": "string",
      "description": "Location of the open door"
    },
    "door_description": {
      "type": "string",
      "description": "Description of which door (e.g., Main entrance, Unit 204)"
    },
    "action_taken": {
      "type": "string",
      "description": "What action was taken (secured, notified resident, etc.)"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "photo_url": {
      "type": "string",
      "description": "Photo of the open door"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "secured",
        "referred"
      ],
      "default": "open",
      "description": "Status of the door"
    },
    "officer_ip_address": {
      "type": "string",
      "description": "IP address of officer when submitting report"
    }
  },
  "required": [
    "report_date",
    "location",
    "door_description"
  ]
}