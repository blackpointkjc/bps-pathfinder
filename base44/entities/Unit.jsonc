{
  "name": "Unit",
  "type": "object",
  "properties": {
    "unit_id": {
      "type": "string",
      "description": "Unique unit identifier"
    },
    "label": {
      "type": "string",
      "description": "Unit display name (e.g., Unit 23)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Available",
        "Dispatched",
        "Enroute",
        "On Scene",
        "Busy",
        "Distress",
        "Out of Service"
      ],
      "default": "Available",
      "description": "Current operational status"
    },
    "assigned_call_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of currently assigned call IDs"
    },
    "current_latitude": {
      "type": "number",
      "description": "Current GPS latitude"
    },
    "current_longitude": {
      "type": "number",
      "description": "Current GPS longitude"
    },
    "last_update_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last status/location update timestamp"
    },
    "user_id": {
      "type": "string",
      "description": "Linked authentication user ID"
    },
    "current_asset_id": {
      "type": "string",
      "description": "Currently assigned vehicle or asset ID"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes or description for this unit"
    }
  },
  "required": [
    "unit_id",
    "label",
    "status"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "portal_approved": true
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    }
  }
}
