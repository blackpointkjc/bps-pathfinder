{
  "name": "CallOut",
  "type": "object",
  "properties": {
    "officer_email": {
      "type": "string",
      "description": "Email of the officer"
    },
    "officer_name": {
      "type": "string",
      "description": "Name of the officer"
    },
    "call_out_type": {
      "type": "string",
      "enum": [
        "called_out",
        "sent_home",
        "reassigned"
      ],
      "description": "Type of call out, including reassignment to another property"
    },
    "call_out_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the call out"
    },
    "call_out_time": {
      "type": "string",
      "description": "Time when officer called out or was sent home"
    },
    "reason": {
      "type": "string",
      "description": "Reason for call out or being sent home"
    },
    "supervisor_email": {
      "type": "string",
      "description": "Supervisor who documented this"
    },
    "supervisor_name": {
      "type": "string",
      "description": "Name of supervisor"
    },
    "location": {
      "type": "string",
      "description": "Primary location/site where this occurred"
    },
    "original_location": {
      "type": "string",
      "description": "Property the officer was originally working when reassigned"
    },
    "destination_location": {
      "type": "string",
      "description": "Property or assignment the officer was called out/reassigned to"
    },
    "original_shift_id": {
      "type": "string",
      "description": "TimeEntry or schedule identifier for the original shift"
    },
    "exclude_original_incident_metric": {
      "type": "boolean",
      "default": false,
      "description": "Exclude property-call incident-report requirements at the original property after reassignment"
    },
    "affects_pto": {
      "type": "boolean",
      "default": true,
      "description": "Whether this prevents PTO accrual for the day"
    },
    "admin_notified": {
      "type": "boolean",
      "default": false,
      "description": "Whether admin has been notified"
    }
  },
  "required": [
    "officer_email",
    "call_out_type",
    "call_out_date",
    "reason"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}