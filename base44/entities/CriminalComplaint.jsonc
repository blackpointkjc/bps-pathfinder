{
  "name": "CriminalComplaint",
  "type": "object",
  "properties": {
    "complaint_number": {
      "type": "string",
      "description": "Black Point complaint number (e.g., VCC-20250101-0001)"
    },
    "call_number": {
      "type": "string",
      "description": "Call number for tracking"
    },
    "linked_call_id": {
      "type": "string",
      "description": "Linked DispatchCall record ID"
    },
    "linked_call_number": {
      "type": "string",
      "description": "Linked CAD call number"
    },
    "linked_call_type": {
      "type": "string",
      "description": "Linked CAD incident type"
    },
    "linked_call_location": {
      "type": "string",
      "description": "Linked CAD call location"
    },
    "complaint_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date complaint was filed"
    },
    "offense_date": {
      "type": "string",
      "format": "date",
      "description": "Date offense occurred"
    },
    "offense_time": {
      "type": "string",
      "description": "Time offense occurred"
    },
    "location": {
      "type": "string",
      "description": "City/County/Town where offense occurred"
    },
    "location_type": {
      "type": "string",
      "enum": [
        "city",
        "county",
        "town"
      ],
      "default": "city"
    },
    "accused_last_name": {
      "type": "string",
      "description": "Last name of accused"
    },
    "accused_first_name": {
      "type": "string",
      "description": "First name of accused"
    },
    "accused_middle_name": {
      "type": "string",
      "description": "Middle name of accused"
    },
    "accused_address": {
      "type": "string",
      "description": "Address of accused"
    },
    "accused_race": {
      "type": "string",
      "description": "Race of accused"
    },
    "accused_sex": {
      "type": "string",
      "enum": [
        "male",
        "female"
      ],
      "description": "Sex of accused"
    },
    "accused_dob": {
      "type": "string",
      "format": "date",
      "description": "Date of birth"
    },
    "accused_height_ft": {
      "type": "number",
      "description": "Height in feet"
    },
    "accused_height_in": {
      "type": "number",
      "description": "Height in inches"
    },
    "accused_weight": {
      "type": "number",
      "description": "Weight in lbs"
    },
    "accused_eyes": {
      "type": "string",
      "description": "Eye color"
    },
    "accused_hair": {
      "type": "string",
      "description": "Hair color"
    },
    "accused_ssn": {
      "type": "string",
      "description": "Social security number"
    },
    "accused_id_number": {
      "type": "string",
      "description": "Driver license or identification card number"
    },
    "accused_id_state": {
      "type": "string",
      "description": "State that issued the identification card"
    },
    "accused_id_expiration": {
      "type": "string",
      "format": "date",
      "description": "Identification card expiration date"
    },
    "id_scanned_in_person": {
      "type": "boolean",
      "default": false,
      "description": "Whether identification was scanned in person"
    },
    "scan_type": {
      "type": "string",
      "description": "ID scan method"
    },
    "scan_raw": {
      "type": "string",
      "description": "Raw AAMVA barcode payload"
    },
    "scan_parsed_json": {
      "type": "string",
      "description": "Parsed identification data"
    },
    "scanned_at": {
      "type": "string",
      "format": "date-time",
      "description": "Time identification was scanned"
    },
    "scanned_by": {
      "type": "string",
      "description": "Officer who scanned the identification"
    },
    "device_id": {
      "type": "string",
      "description": "Device used to scan identification"
    },
    "id_photo": {
      "type": "string",
      "description": "Uploaded identification image"
    },
    "violation_code": {
      "type": "string",
      "description": "Virginia code violation (e.g., \u00a7 18.2-119)"
    },
    "violation_section": {
      "type": "string",
      "description": "Specific section or subsection of the violation"
    },
    "facts_basis": {
      "type": "string",
      "description": "Facts supporting the complaint"
    },
    "court_type": {
      "type": "string",
      "enum": [
        "general_district",
        "juvenile_domestic"
      ],
      "default": "general_district",
      "description": "Type of court"
    },
    "complainant_name": {
      "type": "string",
      "description": "Name of officer filing complaint"
    },
    "is_law_enforcement": {
      "type": "boolean",
      "default": true,
      "description": "Whether complainant is law enforcement"
    },
    "authorization_given_by": {
      "type": "string",
      "description": "Who authorized felony warrant"
    },
    "authorization_date": {
      "type": "string",
      "format": "date-time",
      "description": "When authorization was given"
    },
    "filed_at_court": {
      "type": "boolean",
      "default": false,
      "description": "Whether complaint was filed at court"
    },
    "court_filing_date": {
      "type": "string",
      "format": "date",
      "description": "Date filed at court"
    },
    "warrant_issued": {
      "type": "boolean",
      "default": false,
      "description": "Whether warrant was issued"
    },
    "warrant_number": {
      "type": "string",
      "description": "Warrant number if issued"
    },
    "subject_arrested_on_site": {
      "type": "boolean",
      "default": false,
      "description": "Whether subject was arrested on site"
    },
    "arrest_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date/time of arrest if arrested on site"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "rejected",
        "approved",
        "filed",
        "warrant_issued",
        "arrested",
        "closed"
      ],
      "default": "draft"
    },
    "admin_notes": {
      "type": "string",
      "description": "Admin feedback for revisions"
    },
    "was_rejected": {
      "type": "boolean",
      "default": false,
      "description": "Whether this complaint was previously rejected"
    },
    "photo_url": {
      "type": "string",
      "description": "Photo evidence"
    },
    "officer_ip_address": {
      "type": "string",
      "description": "IP address of officer when submitting complaint"
    }
  },
  "required": [
    "complaint_date",
    "offense_date",
    "location",
    "accused_last_name",
    "accused_first_name",
    "facts_basis"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}