{
  "name": "PerformanceReview",
  "type": "object",
  "properties": {
    "officer_email": {
      "type": "string",
      "description": "Primary Pathfinder work email of officer being reviewed"
    },
    "officer_id": {
      "type": "string",
      "description": "Immutable Pathfinder user ID of officer being reviewed"
    },
    "review_type": {
      "type": "string",
      "enum": [
        "manual",
        "annual_automatic"
      ],
      "default": "manual",
      "description": "Whether HR created the review manually or the annual automation created it"
    },
    "annual_review_key": {
      "type": "string",
      "description": "Idempotency key for one automatic annual review per officer and anniversary year"
    },
    "generated_year": {
      "type": "number",
      "description": "Anniversary year represented by an automatic review"
    },
    "performance_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Objective performance score calculated for the selected review period"
    },
    "performance_snapshot": {
      "type": "object",
      "description": "Objective period statistics used to generate the review"
    },
    "officer_name": {
      "type": "string",
      "description": "Name of officer"
    },
    "reviewer_email": {
      "type": "string",
      "description": "Email of supervisor conducting review"
    },
    "assigned_supervisor_id": {
      "type": "string",
      "description": "Immutable user ID of the supervisor assigned to conduct the review"
    },
    "assigned_supervisor_email": {
      "type": "string",
      "description": "Work email of the supervisor assigned to conduct the review"
    },
    "assigned_supervisor_name": {
      "type": "string",
      "description": "Display name of the assigned supervisor"
    },
    "supervisor_task_created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the review task was routed to Supervisor Center"
    },
    "reviewer_name": {
      "type": "string",
      "description": "Name of reviewer"
    },
    "review_date": {
      "type": "string",
      "format": "date",
      "description": "Date of review"
    },
    "review_period_start": {
      "type": "string",
      "format": "date",
      "description": "Start of review period"
    },
    "review_period_end": {
      "type": "string",
      "format": "date",
      "description": "End of review period"
    },
    "professionalism_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Rating 1-5"
    },
    "punctuality_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "uniform_appearance_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "communication_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "initiative_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "overall_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Overall performance rating"
    },
    "strengths": {
      "type": "string",
      "description": "Officer's strengths"
    },
    "areas_for_improvement": {
      "type": "string",
      "description": "Areas needing improvement"
    },
    "goals": {
      "type": "string",
      "description": "Goals for next review period"
    },
    "supervisor_notes": {
      "type": "string",
      "description": "Additional supervisor notes"
    },
    "workflow_stage": {
      "type": "string",
      "enum": [
        "higher_reviewer_required",
        "supervisor_pending",
        "officer_pending",
        "hr_approval_pending",
        "approved"
      ],
      "default": "supervisor_pending",
      "description": "Current step in the higher-rank reviewer to officer to HR review cycle"
    },
    "higher_reviewer_required": {
      "type": "boolean",
      "default": false,
      "description": "Whether this review is waiting for an active reviewer who strictly outranks the officer"
    },
    "assignment_issue": {
      "type": "string",
      "description": "Reason the review could not be routed to a valid higher-ranking reviewer"
    },
    "assignment_round": {
      "type": "number",
      "default": 1,
      "description": "Supervisor assignment cycle sequence"
    },
    "supervisor_submitted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the assigned supervisor submitted ratings and feedback"
    },
    "supervisor_rating_comments": {
      "type": "string",
      "description": "Supervisor comments submitted with the ratings"
    },
    "officer_acknowledged": {
      "type": "boolean",
      "default": false,
      "description": "Whether officer has acknowledged review"
    },
    "officer_comments": {
      "type": "string",
      "description": "Officer's comments on review"
    },
    "officer_punctuality_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "officer_professionalism_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "officer_uniform_appearance_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "officer_communication_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "officer_initiative_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "officer_overall_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Officer self-rating submitted before electronic signature"
    },
    "commendations_count": {
      "type": "number",
      "description": "Number of commendations during review period"
    },
    "complaints_count": {
      "type": "number",
      "description": "Number of complaints during review period"
    },
    "inspections_count": {
      "type": "number",
      "description": "Number of inspections during review period"
    },
    "writeups_count": {
      "type": "number",
      "description": "Number of write-ups during review period"
    },
    "hours_worked": {
      "type": "number",
      "description": "Total hours worked during review period"
    },
    "on_time_percentage": {
      "type": "number",
      "description": "Percentage of on-time shifts"
    },
    "current_hourly_rate": {
      "type": "number",
      "description": "Current hourly rate at time of review"
    },
    "suggested_hourly_rate": {
      "type": "number",
      "description": "Suggested hourly rate based on performance"
    },
    "pay_range_min": {
      "type": "number",
      "description": "Minimum pay for officer's rank"
    },
    "pay_range_max": {
      "type": "number",
      "description": "Maximum pay for officer's rank"
    },
    "pay_adjustment_approved": {
      "type": "boolean",
      "default": false,
      "description": "Whether admin approved the pay adjustment"
    },
    "pay_adjustment_approved_by": {
      "type": "string",
      "description": "Email of admin who approved pay adjustment"
    },
    "pay_adjustment_date": {
      "type": "string",
      "format": "date-time",
      "description": "When pay adjustment was approved"
    },
    "pay_effective_date": {
      "type": "string",
      "format": "date",
      "description": "Date when pay adjustment becomes effective"
    },
    "supervisor_review_pending": {
      "type": "boolean",
      "default": false,
      "description": "Whether supervisor needs to review this with officer"
    },
    "supervisor_review_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether supervisor has completed review with officer"
    },
    "supervisor_review_completed_by": {
      "type": "string",
      "description": "Email of supervisor who completed review"
    },
    "supervisor_review_completed_date": {
      "type": "string",
      "format": "date-time",
      "description": "When supervisor completed review with officer"
    },
    "officer_signature_obtained": {
      "type": "boolean",
      "default": false,
      "description": "Whether officer signature was obtained"
    },
    "officer_signature_url": {
      "type": "string",
      "description": "Stored electronic signature image URL"
    },
    "officer_signed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the officer electronically signed the review"
    },
    "officer_acknowledged_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the officer acknowledged the review"
    },
    "officer_acknowledged_by_id": {
      "type": "string",
      "description": "Immutable user ID of the officer who acknowledged the review"
    },
    "hr_approved": {
      "type": "boolean",
      "default": false,
      "description": "Whether HR granted final approval"
    },
    "hr_approved_by": {
      "type": "string",
      "description": "HR user who granted final approval"
    },
    "hr_approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "When HR granted final approval"
    },
    "hr_approval_notes": {
      "type": "string",
      "description": "Final HR approval notes"
    },
    "final_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Final overall rating approved by HR"
    }
  },
  "required": [
    "officer_email",
    "reviewer_email",
    "review_date",
    "overall_rating"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.reviewer_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.officer_email": "{{user.email}}"
        },
        {
          "data.reviewer_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.reviewer_email": "{{user.email}}"
        },
        {
          "data.officer_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}