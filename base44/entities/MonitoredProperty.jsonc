{
  "name": "MonitoredProperty",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Property name or identifier"
    },
    "address": {
      "type": "string",
      "description": "Property address"
    },
    "latitude": {
      "type": "number",
      "description": "Center latitude (used for circle boundary)"
    },
    "longitude": {
      "type": "number",
      "description": "Center longitude (used for circle boundary)"
    },
    "radiusMeters": {
      "type": "number",
      "description": "Monitoring radius in meters (circle mode only)",
      "default": 500
    },
    "boundary_type": {
      "type": "string",
      "enum": [
        "circle",
        "polygon"
      ],
      "default": "circle",
      "description": "How the boundary is defined"
    },
    "polygon": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      },
      "description": "Polygon vertices as [[lat, lng], ...] pairs (polygon mode only)"
    },
    "enabled": {
      "type": "boolean",
      "description": "Whether property monitoring is active",
      "default": true
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes or details about this monitored property"
    }
  },
  "required": [
    "name",
    "address"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}