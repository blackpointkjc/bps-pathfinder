{
  "name": "PersonnelPromotion",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string"
    },
    "officer_id": {
      "type": "string"
    },
    "officer_email": {
      "type": "string"
    },
    "officer_name": {
      "type": "string"
    },
    "previous_rank": {
      "type": "string"
    },
    "new_rank": {
      "type": "string"
    },
    "previous_unit": {
      "type": "string"
    },
    "new_unit": {
      "type": "string"
    },
    "previous_platoon": {
      "type": "string"
    },
    "new_platoon": {
      "type": "string"
    },
    "oversight_platoon": {
      "type": "string"
    },
    "previous_supervisor": {
      "type": "string"
    },
    "new_supervisor": {
      "type": "string"
    },
    "new_supervisor_id": {
      "type": "string"
    },
    "transfer_count": {
      "type": "number"
    },
    "transfer_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effective_date": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "processing",
        "applying",
        "partial",
        "complete",
        "failed",
        "cancelled"
      ],
      "default": "scheduled"
    },
    "announcement_id": {
      "type": "string"
    },
    "announcement_published": {
      "type": "boolean",
      "default": false
    },
    "requested_by": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "applied_at": {
      "type": "string"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effective_at_eastern": {
      "type": "string"
    },
    "planned_patch": {
      "type": "object",
      "additionalProperties": true
    },
    "planned_transfers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "new_profile_photo_url": {
      "type": "string"
    },
    "system_role": {
      "type": "string"
    },
    "new_additional_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "processing_token": {
      "type": "string"
    },
    "processed_at": {
      "type": "string"
    },
    "approved_at": {
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "officer_id",
    "new_rank",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": false
  }
}
