{
  "name": "Division",
  "type": "object",
  "properties": {
    "division_name": {
      "type": "string",
      "description": "Name of the record (region, division, or substation name)"
    },
    "subdivision": {
      "type": "string",
      "description": "Operating area / subdivision name (mirrors division_name for divisions and substations)"
    },
    "parent_division": {
      "type": "string",
      "description": "Name of the parent record: a division points to its region, a substation points to its division"
    },
    "is_subdivision": {
      "type": "boolean",
      "default": false,
      "description": "False for a region, true for a division or substation"
    },
    "division_level": {
      "type": "string",
      "enum": [
        "region",
        "division",
        "substation"
      ],
      "description": "Placement in the company structure: region (state), division (operating area inside a region), or substation (area inside a division)"
    },
    "region": {
      "type": "string",
      "description": "Region this record ultimately belongs to (for a region this is its own name)"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this division is active"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about the division"
    }
  },
  "required": [
    "division_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}