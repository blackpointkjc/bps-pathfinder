{
  "name": "TrainingCertificate",
  "type": "object",
  "properties": {
    "certificate_number": {
      "type": "string",
      "description": "Internal certificate number/record ID"
    },
    "class_id": {
      "type": "string",
      "description": "ID of the associated TrainingClass"
    },
    "attendee_id": {
      "type": "string",
      "description": "ID of the associated TrainingAttendee"
    },
    "student_name": {
      "type": "string",
      "description": "Student full name"
    },
    "student_dcjs": {
      "type": "string",
      "description": "Student DCJS number"
    },
    "student_dob": {
      "type": "string",
      "format": "date",
      "description": "Student date of birth"
    },
    "student_email": {
      "type": "string"
    },
    "course_title": {
      "type": "string",
      "description": "Course title"
    },
    "course_id": {
      "type": "string",
      "description": "Course ID or code"
    },
    "training_type": {
      "type": "string",
      "description": "Type of training completed"
    },
    "completion_date": {
      "type": "string",
      "format": "date",
      "description": "Date of completion"
    },
    "class_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the class session"
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "description": "Certificate issue date"
    },
    "instructor_name": {
      "type": "string",
      "description": "Instructor name"
    },
    "instructor_signature_url": {
      "type": "string",
      "description": "Instructor signature image URL"
    },
    "school_name": {
      "type": "string",
      "description": "Training school official name"
    },
    "school_dcjs_id": {
      "type": "string",
      "description": "School DCJS ID in 88-XXXX format"
    },
    "school_address": {
      "type": "string"
    },
    "school_phone": {
      "type": "string"
    },
    "school_logo_url": {
      "type": "string"
    },
    "footer_text": {
      "type": "string",
      "description": "Certificate footer statement"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready_for_review",
        "approved",
        "issued",
        "rejected"
      ],
      "default": "draft",
      "description": "Certificate approval status"
    },
    "admin_notes": {
      "type": "string",
      "description": "Admin review notes"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Admin who reviewed"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date-time"
    },
    "quiz_score": {
      "type": "number"
    },
    "quiz_total": {
      "type": "number"
    },
    "quiz_percentage": {
      "type": "number"
    }
  },
  "required": [
    "student_name",
    "course_title",
    "completion_date",
    "instructor_name"
  ]
}