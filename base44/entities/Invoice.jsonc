{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string",
      "description": "Invoice number in format YY + sequential number (e.g., 26001, 26002)"
    },
    "billing_rate_verified_by": {
      "type": "string"
    },
    "billing_rate_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "billing_rate_verified_value": {
      "type": "number"
    },
    "billing_review_required": {
      "type": "boolean",
      "default": false
    },
    "billing_review_reason": {
      "type": "string"
    },
    "revision": {
      "type": "number",
      "description": "Invoice document version"
    },
    "revision_history": {
      "type": "string",
      "description": "JSON audit log of prior in-place invoice revisions"
    },
    "delivery_email": {
      "type": "string",
      "description": "Actual outgoing invoice email recipient"
    },
    "delivery_status": {
      "type": "string",
      "description": "pending, accepted, or failed. Accepted does not prove final delivery"
    },
    "delivery_error": {
      "type": "string"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "client_email": {
      "type": "string",
      "description": "Email of the client"
    },
    "site_name": {
      "type": "string",
      "description": "Site/location name"
    },
    "period_start": {
      "type": "string",
      "format": "date",
      "description": "Invoice period start date"
    },
    "period_end": {
      "type": "string",
      "format": "date",
      "description": "Invoice period end date"
    },
    "total_hours": {
      "type": "number",
      "description": "Total billable hours"
    },
    "bill_rate": {
      "type": "number",
      "description": "Hourly bill rate"
    },
    "total_amount": {
      "type": "number",
      "description": "Total invoice amount"
    },
    "base_amount": {
      "type": "number",
      "description": "Original service charge before late fees"
    },
    "late_fee_amount": {
      "type": "number",
      "default": 0,
      "description": "One-time 10 percent late fee assessed after due date"
    },
    "late_fee_rate": {
      "type": "number",
      "default": 0.1
    },
    "late_fee_applied_at": {
      "type": "string",
      "format": "date-time"
    },
    "late_notice_status": {
      "type": "string"
    },
    "late_notice_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "amount_paid": {
      "type": "number",
      "default": 0,
      "description": "Cumulative client payment received and confirmed by accounting"
    },
    "payment_method": {
      "type": "string"
    },
    "payment_reference": {
      "type": "string"
    },
    "payment_notes": {
      "type": "string"
    },
    "payment_updated_by": {
      "type": "string"
    },
    "payment_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "pending",
        "partial",
        "paid",
        "overdue",
        "void"
      ],
      "default": "sent",
      "description": "Invoice status"
    },
    "shifts": {
      "type": "string",
      "description": "JSON string of shift details"
    },
    "notes": {
      "type": "string",
      "description": "Additional invoice notes"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Payment due date"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "description": "Date invoice was paid"
    }
  },
  "required": [
    "invoice_number",
    "client_email",
    "site_name",
    "period_start",
    "period_end",
    "total_amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "id": "6a72bbee2842d6338cbae513"
      }
    },
    "update": {
      "user_condition": {
        "id": "6a72bbee2842d6338cbae513"
      }
    },
    "delete": {
      "user_condition": {
        "id": "6a72bbee2842d6338cbae513"
      }
    },
    "read": {
      "$or": [
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "id": "6a72bbee2842d6338cbae513"
          }
        }
      ]
    }
  }
}
