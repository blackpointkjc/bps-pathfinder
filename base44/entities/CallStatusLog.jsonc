{
  "name": "CallStatusLog",
  "type": "object",
  "properties": {
    "call_id": {
      "type": "string",
      "description": "Dispatch call ID"
    },
    "incident_type": {
      "type": "string",
      "description": "Type of incident"
    },
    "location": {
      "type": "string",
      "description": "Call location"
    },
    "old_status": {
      "type": "string",
      "description": "Previous status"
    },
    "new_status": {
      "type": "string",
      "description": "New status"
    },
    "unit_id": {
      "type": "string",
      "description": "Unit that triggered change"
    },
    "unit_name": {
      "type": "string",
      "description": "Unit identifier"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "latitude": {
      "type": "number",
      "description": "Call latitude"
    },
    "longitude": {
      "type": "number",
      "description": "Call longitude"
    },
    "event_key": {
      "type": "string",
      "description": "Stable unique identity for announcement deduplication across refreshes, sessions, and devices"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "new_call",
        "priority_call",
        "bolo_published",
        "unit_dispatched",
        "unit_enroute",
        "unit_on_scene",
        "unit_cleared",
        "unit_available",
        "additional_unit",
        "unit_reassigned",
        "backup_requested",
        "officer_emergency",
        "welfare_overdue",
        "property_alert",
        "priority_upgraded",
        "call_cancelled",
        "call_cleared",
        "no_eligible_unit"
      ],
      "description": "Verified CAD transition that may produce an operational announcement"
    },
    "announcement_text": {
      "type": "string",
      "description": "Permission-safe wording approved for voice and matching visual notification"
    },
    "announcement_priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "critical",
        "emergency"
      ],
      "default": "normal"
    },
    "cad_number": {
      "type": "string",
      "description": "Related CAD number or internal reference"
    },
    "triggering_action": {
      "type": "string",
      "description": "Backend action that created this verified event"
    },
    "audio_enabled": {
      "type": "boolean",
      "default": true
    },
    "sensitive": {
      "type": "boolean",
      "default": false,
      "description": "When true, only authorized CAD roles may receive spoken details"
    }
  },
  "required": [
    "call_id",
    "new_status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}