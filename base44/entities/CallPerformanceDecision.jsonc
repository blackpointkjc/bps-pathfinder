{
  "name": "CallPerformanceDecision",
  "type": "object",
  "properties": {
    "call_id": {
      "type": "string"
    },
    "excluded": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "enum": [
        "off_property",
        "offsite",
        "restored"
      ]
    }
  },
  "required": [
    "call_id",
    "excluded",
    "reason"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "portal_approved": true
          }
        }
      ]
    },
    "update": false,
    "delete": false
  }
}
