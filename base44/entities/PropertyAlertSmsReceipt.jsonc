{
  "name": "PropertyAlertSmsReceipt",
  "type": "object",
  "properties": {
    "event_key": {
      "type": "string"
    },
    "property_alert_id": {
      "type": "string"
    },
    "call_id": {
      "type": "string"
    },
    "property_id": {
      "type": "string"
    },
    "property_name": {
      "type": "string"
    },
    "recipient_email": {
      "type": "string"
    },
    "recipient_name": {
      "type": "string"
    },
    "recipient_phone": {
      "type": "string"
    },
    "recipient_scope": {
      "type": "string",
      "enum": [
        "admin",
        "duty_supervisor",
        "on_site_officer"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "failed",
        "skipped"
      ],
      "default": "skipped"
    },
    "provider": {
      "type": "string",
      "default": "twilio"
    },
    "provider_message_id": {
      "type": "string"
    },
    "message_text": {
      "type": "string",
      "maxLength": 2000
    },
    "error": {
      "type": "string",
      "maxLength": 2000
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "event_key",
    "property_alert_id",
    "recipient_phone",
    "recipient_scope",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}