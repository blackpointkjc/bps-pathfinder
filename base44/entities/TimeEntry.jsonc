{
  "name": "TimeEntry",
  "type": "object",
  "properties": {
    "officer_email": {
      "type": "string",
      "description": "Email of the officer this time entry belongs to"
    },
    "clock_in": {
      "type": "string",
      "format": "date-time",
      "description": "When the officer clocked in"
    },
    "clock_out": {
      "type": "string",
      "format": "date-time",
      "description": "When the officer clocked out"
    },
    "location": {
      "type": "string",
      "description": "Location where clock in/out occurred"
    },
    "clock_in_latitude": {
      "type": "number",
      "description": "GPS latitude where officer clocked in"
    },
    "clock_in_longitude": {
      "type": "number",
      "description": "GPS longitude where officer clocked in"
    },
    "clock_in_accuracy": {
      "type": "number",
      "description": "Browser-reported accuracy radius in meters at clock in"
    },
    "location_verification_status": {
      "type": "string",
      "enum": [
        "verified",
        "low_accuracy_review",
        "manual_override"
      ],
      "description": "How the clock-in location was verified"
    },
    "location_verification_note": {
      "type": "string",
      "description": "Audit explanation when a low-accuracy or manual location fallback was used"
    },
    "clock_out_latitude": {
      "type": "number",
      "description": "GPS latitude where officer clocked out"
    },
    "clock_out_longitude": {
      "type": "number",
      "description": "GPS longitude where officer clocked out"
    },
    "on_break": {
      "type": "boolean",
      "default": false,
      "description": "Whether the officer is currently on an unpaid break"
    },
    "break_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the current break started (null when not on break)"
    },
    "break_periods": {
      "type": "array",
      "description": "Completed break periods with start and end timestamps",
      "items": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "payroll_adjustment_decision": {
      "type": "string",
      "enum": [
        "relief_delay_approved",
        "pay_overage_with_performance",
        "deny_overage_pay"
      ],
      "description": "Admin decision for post-shift relief delay or excess-hours handling"
    },
    "payroll_hours_override": {
      "type": "number",
      "description": "Hours approved for payroll without changing the true clock punches"
    },
    "actual_hours_snapshot": {
      "type": "number",
      "description": "Actual paid hours calculated from the immutable clock punches when the decision was made"
    },
    "approved_hours_snapshot": {
      "type": "number",
      "description": "Payroll hours approved by the administrator when the decision was made"
    },
    "performance_exception": {
      "type": "boolean",
      "default": false,
      "description": "Whether the excess time is excluded from performance because the next officer arrived late"
    },
    "performance_overage_counted": {
      "type": "boolean",
      "default": false,
      "description": "Whether the excess time is counted as a performance overrun"
    },
    "payroll_adjustment_reason": {
      "type": "string",
      "description": "Required audit reason for the payroll and performance decision"
    },
    "relief_officer_email": {
      "type": "string",
      "description": "Optional email of the late relief officer connected to the exception"
    },
    "payroll_adjusted_by": {
      "type": "string",
      "description": "Administrator email that made the payroll decision"
    },
    "payroll_adjusted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the payroll decision was made"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about the shift"
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "Whether entry is archived"
    }
  },
  "required": [
    "officer_email",
    "clock_in"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.officer_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.officer_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}