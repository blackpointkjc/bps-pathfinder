{
  "name": "OutlookMailboxLink",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Pathfinder user ID"
    },
    "pathfinder_email": {
      "type": "string",
      "description": "Pathfinder account login email"
    },
    "outlook_email": {
      "type": "string",
      "description": "Connected Outlook/Microsoft 365 mailbox email"
    },
    "outlook_display_name": {
      "type": "string",
      "description": "Microsoft mailbox display name"
    },
    "microsoft_user_id": {
      "type": "string",
      "description": "Microsoft Graph user object ID"
    },
    "connected": {
      "type": "boolean",
      "default": true
    },
    "connected_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "disconnected_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "pathfinder_email",
    "outlook_email"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    }
  }
}
