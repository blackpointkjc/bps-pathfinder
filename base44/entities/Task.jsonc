{
  "name": "Task",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "open"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "due_date": {
      "type": "string",
      "format": "date-time"
    },
    "assigned_to": {
      "type": "string",
      "description": "User ID"
    },
    "assigned_name": {
      "type": "string"
    },
    "related_type": {
      "type": "string",
      "enum": [
        "incident",
        "lead",
        "client",
        "contract",
        "site",
        "general"
      ],
      "description": "Type of linked record"
    },
    "related_id": {
      "type": "string",
      "description": "ID of linked record"
    },
    "related_name": {
      "type": "string",
      "description": "Display name of linked record"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "status"
  ]
}