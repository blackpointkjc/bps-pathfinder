{
  "name": "PortalInvitation",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "account_type": {
      "type": "string"
    },
    "profile": {
      "type": "object",
      "additionalProperties": true
    },
    "invited_by": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "email_sent": {
      "type": "boolean"
    },
    "email_error": {
      "type": "string"
    },
    "last_delivery_attempt_at": {
      "type": "string",
      "format": "date-time"
    },
    "delivery_provider": {
      "type": "string"
    }
  },
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}
