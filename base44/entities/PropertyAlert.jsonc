{
  "name": "PropertyAlert",
  "type": "object",
  "properties": {
    "callId": {
      "type": "string",
      "description": "ID of the dispatch call"
    },
    "propertyId": {
      "type": "string",
      "description": "ID of the monitored property"
    },
    "propertyName": {
      "type": "string",
      "description": "Name of the property"
    },
    "callIncident": {
      "type": "string",
      "description": "Call incident type"
    },
    "callLocation": {
      "type": "string",
      "description": "Call location"
    },
    "callTime": {
      "type": "string",
      "format": "date-time",
      "description": "Authoritative dispatch call received time"
    },
    "time_received": {
      "type": "string",
      "format": "date-time",
      "description": "Compatibility copy of the dispatch received time"
    },
    "source_key": {
      "type": "string",
      "description": "Stable call/property fingerprint used to prevent duplicate alerts"
    },
    "distanceMeters": {
      "type": "number",
      "description": "Distance from property to call in meters"
    },
    "acknowledged": {
      "type": "boolean",
      "description": "Whether alert has been acknowledged",
      "default": false
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "active",
        "assigned",
        "acknowledged",
        "resolved",
        "false_alarm",
        "test"
      ],
      "default": "active"
    },
    "is_test": {
      "type": "boolean",
      "default": false
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_by": {
      "type": "string"
    },
    "resolution_reason": {
      "type": "string",
      "maxLength": 1000
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes about this property alert"
    }
  },
  "required": [
    "callId",
    "propertyId",
    "propertyName",
    "callIncident",
    "callLocation",
    "distanceMeters"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}