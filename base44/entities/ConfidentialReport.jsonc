{
  "name": "ConfidentialReport",
  "type": "object",
  "properties": {
    "linked_call_id": {
      "type": "string",
      "description": "Linked DispatchCall record ID"
    },
    "linked_call_number": {
      "type": "string",
      "description": "Linked CAD call number"
    },
    "linked_call_type": {
      "type": "string",
      "description": "Linked CAD incident type"
    },
    "linked_call_location": {
      "type": "string",
      "description": "Linked CAD call location"
    },
    "report_type": {
      "type": "string",
      "enum": [
        "workplace_concern",
        "safety_issue",
        "policy_concern",
        "team_issue",
        "management_concern",
        "other"
      ],
      "description": "Type of concern being reported"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the concern"
    },
    "preferred_contact_method": {
      "type": "string",
      "enum": [
        "email",
        "phone",
        "in_person",
        "no_contact"
      ],
      "description": "How officer prefers to be contacted"
    },
    "anonymous": {
      "type": "boolean",
      "default": false,
      "description": "Whether the officer wants to remain anonymous"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "reviewed",
        "investigating",
        "resolved"
      ],
      "default": "new",
      "description": "Status of the report"
    },
    "viewed": {
      "type": "boolean",
      "default": false,
      "description": "Whether admin has viewed the report"
    },
    "admin_notes": {
      "type": "string",
      "description": "Internal admin notes about the report"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Email of admin who reviewed"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date-time",
      "description": "When it was reviewed"
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "Whether report has been moved to inactive"
    }
  },
  "required": [
    "report_type",
    "description"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}