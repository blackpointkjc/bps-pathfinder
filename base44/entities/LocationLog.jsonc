{
  "name": "LocationLog",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User ID of the officer"
    },
    "user_name": {
      "type": "string",
      "description": "Name of the officer"
    },
    "unit_number": {
      "type": "string",
      "description": "Unit number"
    },
    "latitude": {
      "type": "number",
      "description": "GPS latitude"
    },
    "longitude": {
      "type": "number",
      "description": "GPS longitude"
    },
    "address": {
      "type": "string",
      "description": "Geocoded address"
    },
    "shift_date": {
      "type": "string",
      "format": "date",
      "description": "Date of shift"
    },
    "status": {
      "type": "string",
      "description": "Officer status at time of log"
    },
    "speed": {
      "type": "number",
      "description": "Speed in mph (if available)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes about this location entry"
    }
  },
  "required": [
    "user_id",
    "latitude",
    "longitude"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "portal_approved": true
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
