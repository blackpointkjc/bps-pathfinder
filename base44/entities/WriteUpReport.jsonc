{
  "name": "WriteUpReport",
  "type": "object",
  "properties": {
    "report_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date and time of write-up"
    },
    "officer_name": {
      "type": "string",
      "description": "Name of officer being written up"
    },
    "officer_email": {
      "type": "string",
      "description": "Email of officer being written up"
    },
    "incident_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date and time of incident"
    },
    "location": {
      "type": "string",
      "description": "Location where incident occurred"
    },
    "violation_type": {
      "type": "string",
      "enum": [
        "policy_violation",
        "tardiness",
        "uniform_violation",
        "insubordination",
        "performance_issue",
        "conduct_violation",
        "other"
      ],
      "description": "Type of violation"
    },
    "severity": {
      "type": "string",
      "enum": [
        "verbal_warning",
        "written_warning",
        "final_warning",
        "suspension_recommended",
        "termination_recommended"
      ],
      "default": "written_warning",
      "description": "Severity level of disciplinary action"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the incident"
    },
    "corrective_action": {
      "type": "string",
      "description": "Required corrective actions"
    },
    "officer_statement": {
      "type": "string",
      "description": "Statement from the officer"
    },
    "witnesses": {
      "type": "string",
      "description": "Witness information"
    },
    "acknowledged_by_officer": {
      "type": "boolean",
      "default": false,
      "description": "Whether officer has acknowledged the write-up"
    },
    "expiration_date": {
      "type": "string",
      "format": "date",
      "description": "Date when corrective action plan expires"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_approval",
        "approved",
        "rejected"
      ],
      "default": "draft",
      "description": "Approval status of write-up"
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "Whether write-up is archived after expiration"
    },
    "admin_notes": {
      "type": "string",
      "description": "Notes from admin review"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Email of admin who reviewed"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date-time",
      "description": "When admin reviewed"
    },
    "exclude_from_performance_review": {
      "type": "boolean",
      "default": false,
      "description": "Whether to exclude this from officer's performance review"
    }
  },
  "required": [
    "report_date",
    "officer_name",
    "officer_email",
    "incident_date",
    "location",
    "violation_type",
    "description"
  ]
}