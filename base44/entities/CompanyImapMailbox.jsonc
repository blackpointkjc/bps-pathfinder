{
  "name": "CompanyImapMailbox",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "pathfinder_email": {
      "type": "string"
    },
    "mailbox_email": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "approved_by_company": {
      "type": "boolean",
      "default": true
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "imap_host": {
      "type": "string"
    },
    "imap_port": {
      "type": "number",
      "default": 993
    },
    "imap_secure": {
      "type": "boolean",
      "default": true
    },
    "smtp_host": {
      "type": "string"
    },
    "smtp_port": {
      "type": "number",
      "default": 465
    },
    "smtp_secure": {
      "type": "boolean",
      "default": true
    },
    "username": {
      "type": "string"
    },
    "password": {
      "type": "string",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "reply_to": {
      "type": "string"
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_error": {
      "type": "string"
    },
    "updated_by": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "mailbox_email",
    "imap_host",
    "smtp_host",
    "username"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}